[Desktop Entry]
Type=Application
Name=Griffel
GenericName=Markdown Editor
Comment=A distraction-free Markdown editor
Exec=griffel %U
Icon=io.github.hakergeniusz.Griffel
Terminal=false
Categories=GNOME;GTK;Office;TextEditor;
Keywords=markdown;editor;writing;distraction-free;notes;
MimeType=text/markdown;text/x-markdown;text/plain;text/x-python;text/rust;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/javascript;text/typescript;text/x-java;text/x-go;text/x-ruby;text/x-php;text/x-swift;text/x-kotlin;text/x-csharp;text/x-shellscript;text/x-lua;text/x-perl;text/x-sql;text/css;application/json;application/x-yaml;application/toml;text/xml;text/x-makefile;
DBusActivatable=true
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=griffel --new-window
