# AUR-style PKGBUILD for Griffel, following the Arch/Rust package
# guidelines. The git tag, Cargo.toml, debian/changelog and the Fedora
# spec must be bumped together; on a version bump, update sha256sums
# (updpkgsums) along with pkgver/_tag.
# Maintainer: hakergeniusz <hakergeniusz@users.noreply.github.com>

pkgname=griffel
_tag=v51.0.0-rc.1
pkgver=51.0.0rc1
pkgrel=1
pkgdesc="Distraction-free Markdown editor for the Linux desktop"
arch=('x86_64')
url="https://github.com/hakergeniusz/griffel"
license=('MIT')
depends=('gtk4' 'libadwaita' 'gtksourceview5' 'webkitgtk-6.0' 'enchant')
optdepends=('pandoc: live preview and export'
            'typst: Typst PDF export'
            'texlive-xetex: LaTeX PDF export')
makedepends=('cargo')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
sha256sums=('01a9e254ca88eeb0ca2cecafdafa22c08b93e4f45976a1c84dd78362c36b8df6')

prepare() {
  cd "$pkgname-51.0.0-rc.1"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-51.0.0-rc.1"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="target"
  # --frozen = --locked --offline: deps are pinned and already fetched.
  cargo build --frozen --release
}

check() {
  cd "$pkgname-51.0.0-rc.1"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="target"
  cargo test --frozen
  ./target/release/griffel --version
}

package() {
  cd "$pkgname-51.0.0-rc.1"
  install -Dm755 target/release/griffel -t "$pkgdir/usr/bin"
  install -Dm644 data/io.github.hakergeniusz.Griffel.desktop \
    "$pkgdir/usr/share/applications/io.github.hakergeniusz.Griffel.desktop"
  install -Dm644 data/io.github.hakergeniusz.Griffel.service \
    "$pkgdir/usr/share/dbus-1/services/io.github.hakergeniusz.Griffel.service"
  install -Dm644 data/io.github.hakergeniusz.Griffel.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.hakergeniusz.Griffel.metainfo.xml"
  install -Dm644 resources/icons/io.github.hakergeniusz.Griffel.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.hakergeniusz.Griffel.svg"
  install -Dm644 resources/icons/io.github.hakergeniusz.Griffel-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.hakergeniusz.Griffel-symbolic.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/griffel/LICENSE"
}
